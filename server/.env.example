APP_NAME=AURA API
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
# Startup routines can modify jobs/storage. The containment Compose forces both false.
ENABLE_STARTUP_RECOVERY=true
ENABLE_CACHE_BACKFILL=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aura
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# ES256/RS256: public JWKS derived from HTTPS SUPABASE_URL (no JWT secret needed).
# HS256 only: configure the trusted server-side signing secret; never an API key.
SUPABASE_JWT_SECRET=
DEEZER_API_BASE_URL=https://api.deezer.com
LOG_LEVEL=INFO
SYNC_FILES_DIR=sync_files
UPDATES_DIR=updates
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000

# Spotify API (Optional, for full playlist import > 100 tracks)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
