APP_NAME=AURA API
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
# Startup routines can modify jobs/storage. The containment Compose forces both false.
ENABLE_STARTUP_RECOVERY=true
ENABLE_CACHE_BACKFILL=true
ENABLE_PLAYLIST_ACQUISITION_WORKER=false
# Optional read-only JSON manifest: exact Aura track ID -> video_id, authorized_for_cloud, provenance.
# Select manifest or automatic resolution before enabling the worker; see docs/ops/playlist-sync-candidate.md.
PLAYLIST_AUTHORIZED_AUDIO_MANIFEST=
# manifest: explicit per-track sources. automatic: existing resolver for other playlist tracks.
PLAYLIST_AUDIO_SOURCE_MODE=manifest
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aura
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# ES256/RS256: public JWKS derived from HTTPS SUPABASE_URL (no JWT secret needed).
# HS256 only: configure the trusted server-side signing secret; never an API key.
SUPABASE_JWT_SECRET=
DEEZER_API_BASE_URL=https://api.deezer.com
LOG_LEVEL=INFO
SYNC_FILES_DIR=sync_files
# SEC-005: audio bytes, hard receive limit; multipart envelope allows an extra 1 MiB.
UPLOAD_MAX_FILE_BYTES=52428800
# Preserve max(bytes, ratio * filesystem capacity); no individual total quota.
UPLOAD_MIN_FREE_BYTES=10737418240
UPLOAD_MIN_FREE_RATIO=0.10
UPDATES_DIR=updates
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000

# Spotify API (Optional, for full playlist import > 100 tracks)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
