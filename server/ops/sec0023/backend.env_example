# New isolated project ONLY. Fill the generated protected copy, never this tracked template.
# Docker Compose separately requires AURA_SEC0023_IMAGE=sha256:<verified local image ID>.
SUPABASE_URL=https://<ISOLATED_PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Leave empty with ES256; never copy the production HS256 shared secret.
SUPABASE_JWT_SECRET=
APP_ENV=test
APP_DEBUG=false
ENABLE_STARTUP_RECOVERY=false
ENABLE_CACHE_BACKFILL=false
SYNC_FILES_DIR=/app/sync_files
UPDATES_DIR=/app/updates
DATABASE_URL=
CORS_ALLOWED_ORIGINS=https://127.0.0.1:18443
